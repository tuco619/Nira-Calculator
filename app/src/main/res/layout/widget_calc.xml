<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Display: tap to open the history -->
    <LinearLayout
        android:id="@+id/w_display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/bg_display"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_chev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌄"
                android:textColor="#B58CFF"
                android:textSize="16sp" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐾"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_last"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="18sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text=" "
                android:textColor="#A995D6" />
            <TextView
                android:id="@+id/w_main"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2.2"
                android:autoSizeMaxTextSize="64sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0"
                android:textColor="#F1E6FF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Keypad + history panel -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5">

        <LinearLayout
            android:id="@+id/w_keypad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <ImageView
                    android:id="@+id/k_c"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="c"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_c" />
                <ImageView
                    android:id="@+id/k_bk"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="⌫"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_bk" />
                <ImageView
                    android:id="@+id/k_pct"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="%"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_pct" />
                <ImageView
                    android:id="@+id/k_div"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="÷"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_div" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <ImageView
                    android:id="@+id/k_7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="7"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_7" />
                <ImageView
                    android:id="@+id/k_8"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="8"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_8" />
                <ImageView
                    android:id="@+id/k_9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="9"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_9" />
                <ImageView
                    android:id="@+id/k_mul"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="×"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_mul" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <ImageView
                    android:id="@+id/k_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="4"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_4" />
                <ImageView
                    android:id="@+id/k_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="5"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_5" />
                <ImageView
                    android:id="@+id/k_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="6"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_6" />
                <ImageView
                    android:id="@+id/k_sub"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="-"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_sub" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <ImageView
                    android:id="@+id/k_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="1"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_1" />
                <ImageView
                    android:id="@+id/k_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="2"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_2" />
                <ImageView
                    android:id="@+id/k_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="3"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_3" />
                <ImageView
                    android:id="@+id/k_add"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="+"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_add" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <ImageView
                    android:id="@+id/k_00"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="00"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_00" />
                <ImageView
                    android:id="@+id/k_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="0"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_0" />
                <ImageView
                    android:id="@+id/k_dot"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="."
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_dot" />
                <ImageView
                    android:id="@+id/k_eq"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="eq"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks_eq" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_hist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:background="@drawable/bg_display"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">
                <TextView
                    android:id="@+id/w_hist_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="History"
                    android:textColor="#A995D6"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/w_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Clear"
                    android:textColor="#F1E6FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <ListView
                    android:id="@+id/hist_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@null"
                    android:dividerHeight="0dp" />
                <TextView
                    android:id="@+id/hist_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="No operations yet"
                    android:textColor="#A995D6"
                    android:textSize="14sp" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
