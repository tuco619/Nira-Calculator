                    android:layout_weight="1"
                    android:contentDescription="4"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks2_4" />
                <ImageView
                    android:id="@+id/k_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="5"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks2_5" />
                <ImageView
                    android:id="@+id/k_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="6"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks2_6" />
                <ImageView
