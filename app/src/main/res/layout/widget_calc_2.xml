                            android:autoSizeMinTextSize="8sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:gravity="end|top"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />
