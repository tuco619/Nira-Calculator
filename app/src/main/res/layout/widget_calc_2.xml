            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <ImageView
                    android:id="@+id/k_c"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="c"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks2_c" />
                <ImageView
                    android:id="@+id/k_bk"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="⌫"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks2_bk" />
                <ImageView
                    android:id="@+id/k_pct"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="%"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks2_pct" />
                <ImageView
                    android:id="@+id/k_div"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="÷"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks2_div" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
