                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/k2_mascot" />
                <ImageView
                    android:id="@+id/k_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="0"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
