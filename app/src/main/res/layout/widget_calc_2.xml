                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks2_7" />
                <ImageView
                    android:id="@+id/k_8"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="8"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks2_8" />
                <ImageView
                    android:id="@+id/k_9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="9"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ks2_9" />
                <ImageView
